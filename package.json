{
  "name": "acp-pi",
  "version": "0.2.0",
  "description": "Agent Client Protocol server for Pi: lets any ACP client drive a Pi agent over RPC",
  "type": "module",
  "bin": {
    "acp-pi": "bin/acp-pi.mjs"
  },
  "files": [
    "bin",
    "lib",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node bin/acp-pi.mjs",
    "test": "node --test test/",
    "lint": "node --check bin/acp-pi.mjs"
  },
  "keywords": [
    "pi",
    "pi-package",
    "gentle-shell",
    "acp",
    "agent-client-protocol",
    "agent",
    "bridge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nelsonacos/acp-pi.git"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "zod": "4.6.7"
  },
  "author": {
    "name": "Nelson Acosta",
    "email": "gh.nelchar@gmail.com",
    "url": "https://github.com/nelsonacos"
  },
  "homepage": "https://github.com/nelsonacos/acp-pi#readme",
  "bugs": {
    "url": "https://github.com/nelsonacos/acp-pi/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
